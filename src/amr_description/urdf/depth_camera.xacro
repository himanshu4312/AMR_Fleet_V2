<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

     <xacro:include filename="properties.xacro" />

    <material name="orange">
        <color rgba="1.0 0.5 0 1" />
    </material>

    <link name="depth_camera_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 1.57 0" />
            <geometry>
                <cylinder radius="0.012" length="0.01" />
            </geometry>
            <material name="orange" />
        </visual>

        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <cylinder radius="0.012" length="0.01" />
            </geometry>
        </collision>

        <xacro:cylinder_inertia m="0.05" r="0.012" h="0.01"
                                    xyz="0 0 0" rpy="0 0 0" />
    </link>

    <link name="depth_camera_link_optical" />

    <joint name="depth_camera_joint" type="fixed">
        <parent link="amr_body" />
        <child link="depth_camera_link" />
        <origin xyz="0.21 -0.04 0.195" rpy="0 0 0" />
    </joint>

    <joint name="depth_camera_optical_joint" type="fixed">
        <parent link="depth_camera_link" />
        <child link="depth_camera_link_optical" />
        <origin xyz="0 0 0" rpy="-1.57 0 -1.57"  />

    </joint>

    <gazebo reference="depth_camera_link">
        <sensor name="depth_camera" type="depth_camera">
            <camera>
                 <horizontal_fov>1.0472</horizontal_fov>
                <image>
                    <width>640</width>
                    <height>480</height>
                    <format>R_FLOAT32</format>
                </image>
                <clip>
                    <near>0.1</near>
                    <far>10</far>
                </clip>

                <optical_frame_id>depth_camera_link_optical</optical_frame_id>
                <camera_info_topic>depth_camera_link_optical</camera_info_topic>

            </camera>

            <always_on>1</always_on>
            <update_rate>30</update_rate>
            <visualize>true</visualize>
            <topic>/depth_camera/depth/image_raw</topic>

        </sensor>
    </gazebo>
</robot>
